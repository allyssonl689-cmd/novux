# ================================
# NOVUX FINANCE - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores
# ================================

NODE_ENV=development
PORT=3001

# ================================
# BANCO DE DADOS (PostgreSQL)
# ================================
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/postgres

# ================================
# JWT (JSON Web Tokens)
# ================================
# IMPORTANTE: Use strings longas e aleatórias em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua-chave-secreta-jwt-de-pelo-menos-32-caracteres-aqui
JWT_REFRESH_SECRET=sua-chave-secreta-refresh-de-pelo-menos-32-caracteres-aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# SEGURANÇA
# ================================
BCRYPT_ROUNDS=12

# ================================
# CORS
# ================================
# URL do frontend (sem barra no final)
CORS_ORIGIN=http://localhost:5173

# ================================
# RATE LIMITING
# ================================
# Janela de tempo em milissegundos (padrão: 15 minutos)
RATE_LIMIT_WINDOW_MS=900000
# Máximo de requisições por janela
RATE_LIMIT_MAX=100
