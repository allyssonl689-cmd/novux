# ================================
# NOVUX FINANCE - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores
# ================================

NODE_ENV=development
PORT=3001

# ================================
# LOGIN COM GOOGLE (opcional)
# ================================
# Client ID do OAuth (tipo "Aplicativo Web") do Google Cloud Console.
# DEVE ser o MESMO valor do VITE_GOOGLE_CLIENT_ID do frontend.
# Sem ele, POST /api/auth/google responde 503 (login Google desativado).
# Não é segredo (é público no frontend); não há Client Secret neste fluxo (ID token).
GOOGLE_CLIENT_ID=

# ================================
# BANCO DE DADOS (PostgreSQL)
# ================================
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/postgres

# ================================
# JWT (JSON Web Tokens)
# ================================
# IMPORTANTE: Use strings longas e aleatórias em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua-chave-secreta-jwt-de-pelo-menos-32-caracteres-aqui
JWT_REFRESH_SECRET=sua-chave-secreta-refresh-de-pelo-menos-32-caracteres-aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# SEGURANÇA
# ================================
BCRYPT_ROUNDS=12

# Chave AES-256 para criptografia de PII (nome, e-mail, descrições financeiras, TOTP secret)
# OBRIGATÓRIO — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: perder esta chave torna os dados ilegíveis. Faça backup seguro.
ENCRYPTION_KEY=cole-aqui-64-caracteres-hexadecimais-gerados-pelo-comando-acima

# ================================
# CORS
# ================================
# URL do frontend (sem barra no final)
CORS_ORIGIN=http://localhost:5173

# ================================
# RATE LIMITING
# ================================
# Janela de tempo em milissegundos (padrão: 15 minutos)
RATE_LIMIT_WINDOW_MS=900000
# Máximo de requisições por janela
RATE_LIMIT_MAX=100

# ================================
# SUPABASE STORAGE (comprovantes/anexos)
# ================================
# Armazena os comprovantes em um bucket PRIVADO do Supabase (o disco do Render é
# efêmero e perde os arquivos a cada deploy). O acesso é sempre proxiado pelo
# backend, que valida o dono da transação — o arquivo nunca fica público.
#
# Passos:
#   1. No painel do Supabase: Storage > criar bucket PRIVADO (ex.: "receipts").
#   2. Settings > API: copiar a URL do projeto e a chave "service_role".
# ATENÇÃO: a service_role ignora RLS — NUNCA exponha no frontend.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role
SUPABASE_STORAGE_BUCKET=receipts
